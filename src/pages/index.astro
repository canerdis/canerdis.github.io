---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import WorkList from '../components/WorkList.astro';
import { SITE } from '../config';

// Globbed rather than imported directly so the site still builds before the
// photograph is added. A bare `import portrait from '../assets/portrait.jpg'`
// is a build error while the file is absent.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const viz = (await getCollection('viz')).filter((e) => e.data.featured);
const projects = (await getCollection('projects')).filter((e) => e.data.featured);

const vizTotal = (await getCollection('viz')).length;
const projectTotal = (await getCollection('projects')).length;

const items = [
  ...viz.map((e) => ({
    href: e.data.writeup ? `/visualizations/${e.id}` : e.data.chart.src,
    title: e.data.title, date: e.data.date, summary: e.data.summary,
    image: e.data.chart, alt: e.data.alt, framed: e.data.published,
  })),
  ...projects.map((e) => ({
    href: `/data-science/${e.id}`,
    title: e.data.title, date: e.data.date, summary: e.data.summary,
    image: e.data.cover, alt: e.data.alt, framed: false,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Layout title="Home">
  <section class="intro">
    {portrait && (
      <Image
        class="portrait"
        src={portrait}
        alt={SITE.portrait.alt}
        widths={[208, 416]}
        sizes="13rem"
      />
    )}
    <div class="lead">
      <h1>{SITE.name}</h1>
      <p>{SITE.bio}</p>
    </div>
  </section>

  <p class="tools">{SITE.tools}</p>

  <dl class="facts">
    {SITE.facts.map((f) => (
      <div class="fact">
        <dt class="label">{f.when}</dt>
        <dd>{f.what}</dd>
      </div>
    ))}
  </dl>

  <div class="section-head">
    <h2 class="label">Selected work</h2>
    <p class="more label">
      <a href="/visualizations">All visualizations ({vizTotal})</a>
      <a href="/data-science">Data science ({projectTotal})</a>
    </p>
  </div>
  <WorkList items={items} />
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: var(--space-l);
  }
  /* Deliberate on this one element, not a blanket radius: a portrait reads as
     a portrait when it is round, and nothing else on the site is rounded. */
  .portrait {
    width: 13rem;
    height: 13rem;
    border-radius: 50%;
    object-fit: cover;
    border: var(--rule-width) solid var(--rule);
  }
  .intro h1 { margin: 0 0 1rem; }
  .intro p {
    font-size: var(--step-1);
    margin: 0;
    /* Tighter than the global 65ch. At --step-1 that cap yields roughly 81
       characters of line, which is long for the size. Measure shrinks as
       size grows. */
    max-width: 55ch;
  }

  /* Above the dated facts and in --fg, because this is the line a recruiter
     scans for. No indent: it belongs to the intro, not to the rail. */
  .tools {
    margin: var(--space-m) 0 var(--space-m);
    color: var(--fg);
  }

  /* The CV's shape: a short summary, then dated specifics you can scan. The
     rail clamps between 7rem and 16rem (22vw), matching the work list below,
     so the whole page reads one way: when on the left, what on the right. */
  .facts {
    margin: 0 0 var(--space-l);
    padding-top: var(--space-m);
    border-top: var(--rule-width) solid var(--rule);
  }
  .fact {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    padding: var(--space-xs) 0;
  }
  .fact dt { padding-top: 0.15rem; }
  .fact dd { margin: 0; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    /* --space-m, not --space-l: a heading belongs to the list beneath it, and
       at --space-l it sits as far from the first row as the rows sit from
       each other. It also keeps the first work row's summary clear of the
       fold with room to spare rather than by 8px. */
    margin: 0 0 var(--space-m);
  }
  .section-head h2 { margin: 0; }
  .more { display: flex; gap: var(--space-m); margin: 0; }

  @media (max-width: 40rem) {
    .intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .portrait { width: 9rem; height: 9rem; }
    .fact { grid-template-columns: 1fr; gap: 0.15rem; }
    .fact dt { padding-top: 0; }
  }
</style>
