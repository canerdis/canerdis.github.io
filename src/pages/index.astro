---
import Layout from '../layouts/Layout.astro';
import Facts from '../components/Facts.astro';
import WorkIndex from '../components/WorkIndex.astro';
import Tiles from '../components/Tiles.astro';
import { getWork } from '../lib/work';
import { SITE } from '../config';

const work = await getWork();
// Portrait pictures only: the band crops every tile to the magazine's 4:5,
// which would cut the middle out of a wide chart.
const latest = work
  .filter((it) => it.collection === 'viz' && it.image && it.image.height / it.image.width >= 1.1)
  .slice(0, 4);
const [first, ...rest] = SITE.name.split(' ');
const facts = [...SITE.facts, { k: 'Contact', v: SITE.email, href: `mailto:${SITE.email}`, wide: true }];
const linkedin = SITE.links.find((l) => l.label === 'LinkedIn')!.href;
---
<Layout>
  <section class="frame hero">
    <h1>
      <span class="mask"><span data-rv="mask" data-rv-d="260">{first}</span></span>
      <span class="mask"><span data-rv="mask" data-rv-d="340">{rest.join(' ')}</span></span>
    </h1>
    <p class="lede" data-rv="up" data-rv-d="480">{SITE.line}</p>
  </section>
  <div aria-hidden="true" class="rule" data-rv="sweep" data-rv-d="220"></div>
  <Facts items={facts} delay={520} />
  <div aria-hidden="true" class="rule" data-rv="sweep" data-rv-d="460"></div>

  <Tiles
    items={latest}
    heading="Latest charts"
    link={{ text: 'All charts →', href: '/visualizations', curtain: 'Visualizations' }}
    delay={640}
  />

  <WorkIndex id="work" items={work} heading="Work index" spaced />

  <section id="experience" class="frame">
    <div class="shead shead--gap mono">
      <span aria-hidden="true" class="rule shead__t" data-rv="sweep"></span>
      <h2 data-rv="up">Experience</h2>
      <a class="mlink" href={linkedin} data-rv="up" data-scramble>LinkedIn ↗</a>
      <span aria-hidden="true" class="rule shead__b" data-rv="sweep"></span>
    </div>
    {SITE.experience.map((x) => (
      <div class="row" data-rv="row">
        <span class="row__meta">{x.when}</span>
        <span class="row__body">
          <span class="row__text">
            <span class="row__title row__title--sm">{x.what}</span>
            <span class="row__line">{x.where}</span>
          </span>
        </span>
      </div>
    ))}
    <p class="tools mono muted" data-rv="up">{SITE.tools}</p>
  </section>
</Layout>

<style>
  .tools { margin: 0; padding: 16px var(--pad); border-bottom: 1px solid var(--rule); }
</style>
