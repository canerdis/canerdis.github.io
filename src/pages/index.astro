---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import WorkList from '../components/WorkList.astro';
import { SITE } from '../config';

// Globbed rather than imported directly so the site still builds before the
// photograph is added. A bare `import portrait from '../assets/portrait.jpg'`
// is a build error while the file is absent.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const viz = (await getCollection('viz')).filter((e) => e.data.featured);
const projects = (await getCollection('projects')).filter((e) => e.data.featured);

const items = [
  ...viz.map((e) => ({
    href: e.data.writeup ? `/visualizations/${e.id}` : e.data.chart.src,
    title: e.data.title, date: e.data.date, summary: e.data.summary,
    image: e.data.chart, alt: e.data.alt, framed: e.data.published,
  })),
  ...projects.map((e) => ({
    href: `/data-science/${e.id}`,
    title: e.data.title, date: e.data.date, summary: e.data.summary,
    image: e.data.cover, alt: e.data.alt, framed: false,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Layout title="Home">
  <section class="intro">
    {portrait && (
      <Image
        class="portrait"
        src={portrait}
        alt={SITE.portrait.alt}
        widths={[208, 416]}
        sizes="13rem"
      />
    )}
    <div class="lead">
      <h1>{SITE.name}</h1>
      <p>{SITE.bio}</p>
    </div>
  </section>

  <dl class="facts">
    {SITE.facts.map((f) => (
      <div class="fact">
        <dt class="label">{f.when}</dt>
        <dd>{f.what}</dd>
      </div>
    ))}
  </dl>
  <p class="tools">{SITE.tools}</p>

  <h2 class="label">Selected work</h2>
  <WorkList items={items} />
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }
  /* Deliberate on this one element, not a blanket radius: a portrait reads as
     a portrait when it is round, and nothing else on the site is rounded. */
  .portrait {
    width: 13rem;
    height: 13rem;
    border-radius: 50%;
    object-fit: cover;
    border: var(--rule-width) solid var(--rule);
  }
  .intro h1 { margin: 0 0 1rem; }
  .intro p { font-size: var(--step-1); margin: 0; }

  /* The CV's shape: a short summary, then dated specifics you can scan. The
     8rem rail matches the work list below, so the whole page reads one way:
     when on the left, what on the right. */
  .facts {
    margin: 0;
    padding-top: 1rem;
    border-top: var(--rule-width) solid var(--rule);
  }
  .fact {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    padding: 0.45rem 0;
  }
  .fact dt { padding-top: 0.15rem; }
  .fact dd { margin: 0; }

  /* Undated, so it sits outside the rail rather than pretending to be an
     entry in it. */
  /* Indented with margin, not padding: `padding-left` is inside the box that
     `--measure` caps, so it ate the text's own width and broke a one-line
     note into a narrow ragged column. */
  .tools {
    margin: 0.75rem 0 4rem calc(var(--rail) + var(--rail-gap));
    color: var(--muted);
  }

  h2.label { margin: 0 0 1.5rem; }

  @media (max-width: 40rem) {
    .intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .portrait { width: 9rem; height: 9rem; }
    .fact { grid-template-columns: 1fr; gap: 0.15rem; }
    .fact dt { padding-top: 0; }
    .tools { margin-left: 0; margin-top: 1.25rem; }
  }
</style>
