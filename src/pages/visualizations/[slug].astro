---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Detail from '../../components/Detail.astro';
import { getWork, nextOf, stamp } from '../../lib/work';

export async function getStaticPaths() {
  // Only entries with writeup: true get a page, so nothing acquires a thin
  // one-paragraph stub.
  const entries = (await getCollection('viz')).filter((e) => e.data.writeup);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const work = await getWork();
const item = work.find((it) => it.id === entry.id && it.collection === 'viz')!;
const d = entry.data;

const facts = [
  { k: 'Type', v: d.kind },
  { k: 'Date', v: stamp(d.date, true) },
  { k: 'Tools', v: d.tools.join(', ') || 'n/a' },
  { k: 'Source', v: d.source ?? 'n/a' },
];
const plates = d.gallery.map((g) => ({ src: g.image, alt: g.alt }));
// A shared link to a chart shows the chart itself.
const share = await getImage({ src: d.chart, width: Math.min(1200, d.chart.width), format: 'jpg' });
const links = d.instagram ? [{ label: 'Published', text: 'The original post on Instagram ↗', href: d.instagram }] : [];
---
<Layout title={d.title} description={d.summary} image={{ src: share.src, alt: d.alt }}>
  <Detail item={item} html={entry.rendered?.html ?? ''} next={nextOf(work, item.id)} facts={facts} image={d.chart} alt={d.alt} caption={d.source} plates={plates} links={links} />
</Layout>
