---
import Layout from '../../layouts/Layout.astro';
import Tiles from '../../components/Tiles.astro';
import { getWork } from '../../lib/work';

const items = (await getWork()).filter((it) => it.collection === 'viz');
// Portrait clippings fill a 4:5 frame; if a wide chart is ever added, the
// whole grid switches to showing each picture whole instead of cropping.
const allPortrait = items.every((it) => it.image && it.image.height / it.image.width >= 1.1);
---
<Layout title="Visualizations" description="Charts made from public data, most of them published by Europe Magazine.">
  <section class="frame page-hero page-hero--big">
    <p class="crumb mono" data-rv="up" data-rv-d="150"><a class="mlink" href="/" data-curtain="Index" data-scramble>← Index</a></p>
    <h1><span class="mask"><span data-rv="mask" data-rv-d="220">Visualizations</span></span></h1>
    <p class="lede" data-rv="up" data-rv-d="420">Charts made from public data, most of them published by Europe Magazine. Newest first.</p>
  </section>
  <div aria-hidden="true" class="rule" data-rv="sweep" data-rv-d="300"></div>
  <Tiles items={items} heading="Charts" fit={allPortrait ? 'cover' : 'contain'} delay={460} />
</Layout>
