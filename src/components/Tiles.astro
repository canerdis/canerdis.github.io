---
import { Image } from 'astro:assets';
import type { WorkItem } from '../lib/work';

// Work shown as pictures, in cells separated by hairline gaps. Every tile in
// one grid takes the same frame: `ratio` sets it, and `fit` decides whether a
// picture fills the frame (cover, for the magazine's portrait clippings,
// which all share one shape) or sits whole inside it (contain, for wide
// charts, which a crop would cut through the middle of).
interface Props {
  items: WorkItem[];
  heading: string;
  id?: string;
  link?: { text: string; href: string; curtain: string };
  ratio?: string;
  fit?: 'cover' | 'contain';
  cols?: number;
  delay?: number;
  spaced?: boolean;
}
const { items, heading, id, link, ratio = '4 / 5', fit = 'cover', cols = 4, delay, spaced = false } = Astro.props;
const headingId = `${id ?? heading.toLowerCase().replace(/\W+/g, '-')}-h`;
const at = (n: number) => (delay != null ? delay + n : undefined);
const sizes = `(max-width: 760px) 50vw, ${Math.round(1040 / cols)}px`;
---
<section id={id} class="frame" aria-labelledby={headingId}>
  <div class:list={['shead mono', spaced && 'shead--gap']}>
    {spaced && <span aria-hidden="true" class="rule shead__t" data-rv="sweep"></span>}
    <h2 id={headingId} data-rv="up" data-rv-d={at(0)}>{heading}</h2>
    {link ? (
      <a class="mlink" href={link.href} data-rv="up" data-rv-d={at(60)} data-curtain={link.curtain} data-scramble>{link.text}</a>
    ) : (
      <span class="muted" data-rv="up" data-rv-d={at(60)}>
        <span data-count={items.length}>{String(items.length).padStart(2, '0')}</span> entries
      </span>
    )}
    <span aria-hidden="true" class="rule shead__b" data-rv="sweep" data-rv-d={at(-60)}></span>
  </div>
  <div class="tiles" style={`--cols:${cols};--ratio:${ratio}`} data-fit={fit}>
    {items.map((it, i) => (
      <a class="tile" href={it.href} data-curtain={`${it.no} · ${it.title}`}>
        <span class="tile__img" data-rv="clip" data-rv-d={at(120 + i * 90)}>
          {it.image && (
            <Image src={it.image} alt="" aria-hidden="true" width={Math.min(720, it.image.width)} widths={[360, 720]} sizes={sizes} />
          )}
        </span>
        <span class="tile__cap" data-rv="up" data-rv-d={at(260 + i * 90)}>
          <span class="mono muted">{it.no} · {it.type} <span class="tile__arrow" aria-hidden="true">→</span></span>
          <span class="tile__title">{it.title}</span>
        </span>
      </a>
    ))}
  </div>
</section>
