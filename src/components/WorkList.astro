---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  href: string | null;
  title: string;
  date: Date;
  summary: string;
  image?: ImageMetadata;
  alt?: string;
  // Published artefacts carry their own title and masthead on a light
  // background, so they get the same hairline frame the gallery gives them
  // rather than bleeding into the page.
  framed?: boolean;
}
interface Props { items: Item[] }
const { items } = Astro.props;
// The thumbnail links to the same page as the heading beside it, so it is kept
// out of the tab order (`tabindex="-1"`) to avoid doubling every stop. It stays
// in the accessibility tree, alt text and all.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase();
---
<ol class="worklist">
  {items.map((item) => (
    <li>
      <div class="rail">
        {item.image && (
          <a class:list={['thumb', item.framed && 'framed']} href={item.href} tabindex="-1">
            <Image src={item.image} alt={item.alt ?? item.title} widths={[256, 512]} sizes="16rem" loading="lazy" />
          </a>
        )}
        <time class="label" datetime={item.date.toISOString()}>{fmt(item.date)}</time>
      </div>
      <div class="body">
        <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
        <p>{item.summary}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .worklist { list-style: none; margin: 0; padding: 0; }
  .worklist li {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    padding-top: 1rem;
    margin-bottom: 2.5rem;
    border-top: var(--rule-width) solid var(--rule);
  }
  .worklist h3 { margin: 0 0 0.4rem; }
  .worklist p { margin: 0; color: var(--muted); }

  .rail { display: flex; flex-direction: column; gap: 0.6rem; }
  /* One ratio for every thumbnail, so portrait and landscape sources line the
     rail up instead of stepping in and out. */
  /* The image is positioned rather than sized in percentages: `aspect-ratio`
     does not give a grid row a definite height, so `height: 100%` silently
     fell back to the image's own ratio and portrait sources overflowed. */
  /* No fixed box. These sources range from a portrait Instagram clipping to a
     three-panel chart wider than 3:1, and forcing one ratio on all of them
     either crops the wide ones to an unreadable middle slice or strands the
     tall one in empty space. Each keeps its own shape instead. */
  .thumb { display: block; }
  .thumb :global(img) { display: block; width: 100%; height: auto; }
  /* Published clippings are portrait and would otherwise tower over the row,
     so they are capped by height and shrink to fit. */
  .thumb.framed {
    border: var(--rule-width) solid var(--rule);
    padding: 0.3rem;
    width: fit-content;
    max-width: 100%;
  }
  .thumb.framed :global(img) { width: auto; max-width: 100%; max-height: 13rem; }
  time { display: block; }

  /* The rail collapses on narrow screens; the date leads instead. */
  @media (max-width: 40rem) {
    .worklist li { grid-template-columns: 1fr; gap: 0.5rem; }
    .rail { flex-direction: column-reverse; gap: 0.75rem; }
  }
</style>
