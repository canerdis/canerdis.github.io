---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  chart: ImageMetadata; alt: string; caption?: string; source?: string;
  published?: boolean;
}
const { chart, alt, caption, source, published } = Astro.props;
---
<figure class:list={{ published }}>
  <Picture src={chart} alt={alt} widths={[600, 1000, 1600]} sizes="(max-width: 48rem) 100vw, 70vw" formats={['avif', 'webp']} />
  {(caption || source) && (
    <figcaption>
      {caption}
      {source && <span class="label"> Source: {source}</span>}
    </figcaption>
  )}
</figure>

<style>
  figure { margin: 2.5rem 0; }
  figure img { display: block; width: 100%; }
  figcaption { margin-top: 0.75rem; color: var(--muted); font-size: var(--step--1); max-width: var(--measure); }

  /* Published elsewhere — framed as a clipping. See VizCard for the reasoning.
     Capped in height because these are 3:4 portrait exports for Instagram and
     would otherwise run past a full screen on their own. */
  figure.published img {
    border: var(--rule-width) solid var(--rule);
    padding: 0.75rem;
    max-width: 34rem;
  }
</style>
