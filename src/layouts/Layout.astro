---
import '../styles/global.css';
import { SITE } from '../config';

interface Props { title?: string; description?: string }
const { title, description = SITE.bio } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — pricing, charts and analysis`;
const year = new Date().getFullYear();
const linkedin = SITE.links.find((l) => l.label === 'LinkedIn')!.href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0D10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Runs before first paint. With motion allowed it holds the reveal
        elements at their starting state until the module script takes over
        (and lets go after 3s if it never does), and it covers the page when
        the visitor arrived through the curtain, so nothing flashes. */}
    <script is:inline>
      (() => {
        const d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('rv-pending');
        setTimeout(() => d.classList.remove('rv-pending'), 3000);
        try {
          const label = sessionStorage.getItem('curtain');
          if (label !== null) {
            sessionStorage.removeItem('curtain');
            d.classList.add('curtain-in');
            d.style.setProperty('--curtain-label', JSON.stringify(label));
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <div class="rails" aria-hidden="true"><div data-rv="rails" data-rv-now></div></div>

      <header class="bar">
        <div class="frame bar__inner">
          <a class="wordmark" href="/" data-rv="fade" data-rv-d="150" data-curtain="Index">
            <span class="wordmark__mark" aria-hidden="true"></span>{SITE.name}
          </a>
          <nav class="nav mono" aria-label="Primary" data-rv="fade" data-rv-d="260">
            <a class="mlink" href="/data-science" data-curtain="Data science" data-scramble>Data science</a>
            <a class="mlink nav__wide" href="/visualizations" data-curtain="Visualizations" data-scramble>Charts</a>
            <a class="mlink is-strong" href={`mailto:${SITE.email}`} data-scramble>Contact ↗</a>
            <a class="bar__btn" href={linkedin} aria-label="LinkedIn">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <span class="bar__btn-label">LinkedIn</span>
            </a>
          </nav>
        </div>
        <span class="bar__rule" aria-hidden="true" data-rv="sweep" data-rv-d="80" data-rv-now></span>
        <span class="bar__progress" aria-hidden="true" data-progress></span>
      </header>

      <main id="main"><slot /></main>

      <footer class="frame foot">
        <div data-rv="up">
          <p class="foot__name">{SITE.name}</p>
          <p class="foot__year mono muted">© {year}</p>
        </div>
        <nav class="foot__nav mono" aria-label="Elsewhere" data-rv="up">
          {SITE.links.map((l) => <a class="mlink" href={l.href} data-scramble>{l.label} ↗</a>)}
        </nav>
      </footer>
    </div>

    <div class="curtain" aria-hidden="true" data-curtain-el>
      <div class="curtain__frame"></div>
      <span class="curtain__t" data-cl="t"></span>
      <span class="curtain__b" data-cl="b"></span>
      <span class="curtain__label mono" data-cl="l"></span>
    </div>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
